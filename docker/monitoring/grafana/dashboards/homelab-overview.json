{
  "title": "Homelab Overview",
  "tags": ["homelab"],
  "timezone": "Europe/Paris",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Targets Up",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (job) (up)",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Blackbox Probe Success",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "probe_success",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Filesystem Usage %",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"})",
          "legendFormat": "{{mountpoint}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "id": 4,
      "title": "Memory Usage %",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    },
    {
      "id": 5,
      "title": "Container CPU Usage (top)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "topk(8, sum by (name) (rate(container_cpu_usage_seconds_total{image!=\"\"}[5m])))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 }
    }
  ]
}
